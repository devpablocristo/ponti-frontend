{
  "name": "ui-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc -b && vite build --configLoader runner",
    "generate:ai-types": "node ./scripts/generate-ai-types.mjs",
    "codegen:openapi": "swagger2openapi ../../ponti-backend/docs/openapi/swagger.yaml -o ../../ponti-backend/docs/openapi/openapi.yaml --yaml && openapi-typescript ../../ponti-backend/docs/openapi/openapi.yaml -o src/api/generated/types.ts",
    "lint": "eslint . && yarn lint:notify-leaks",
    "lint:fix": "eslint . --fix",
    "lint:notify-leaks": "bash scripts/lint-notify-leaks.sh",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@devpablocristo/platform-authn": "^0.1.0",
    "@devpablocristo/platform-browser": "^0.1.0",
    "@devpablocristo/platform-http": "^0.1.0",
    "@devpablocristo/platform-ui-data-display": "^0.1.0",
    "axios": "^1.16.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.477.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.12.0",
    "react-to-pdf": "^3.2.2",
    "react-window": "^2.2.7",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7"
  },
  "resolutions": {
    "axios": "^1.16.0",
    "follow-redirects": "^1.16.0",
    "form-data": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-window": "^2.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
