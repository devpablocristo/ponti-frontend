BASE_MANAGER_API=http://localhost:8080/api/v1

LOCAL_DEV_AUTH=1
LOCAL_DEV_USER_ID=1
X_API_KEY=local-dev-api-key
IDENTITY_PLATFORM_API_KEY=your-identity-platform-web-api-key
IDENTITY_PLATFORM_PROJECT_ID=your-identity-platform-project-id

# Opcional: fuerza hostname canónico con redirect 308 (evita pérdida de sesión por cambio de dominio).
# Ejemplo: dev---ponti-frontend-vjhlkdxpoa-uc.a.run.app
# CANONICAL_HOST=

# Auth local: con LOCAL_DEV_AUTH=1 el BFF emite tokens locales para desarrollo.
# Para usar Identity Platform real, desactivar LOCAL_DEV_AUTH y configurar:
# IDENTITY_PLATFORM_API_KEY e IDENTITY_PLATFORM_PROJECT_ID.

# ENABLE_MOCKS=1 activa MSW (mocks). Solo usar para testing aislado del BFF sin backend real.
# Por defecto desactivado: las peticiones van al backend real.
# ENABLE_MOCKS=1

# Errores genéricos del BFF (p. ej. fallo del proxy SSE /ai/chat/stream) incluyen detalle seguro
# en el JSON (sin headers ni API keys). Activar solo en local / depuración; en Cloud Run omitir o false.
# BFF_VERBOSE_ERRORS=true
